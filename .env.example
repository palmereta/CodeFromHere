# --- Network ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Behind a TLS reverse proxy (nginx, Caddy, Traefik):
# TRUST_PROXY=1
# SECURE_COOKIES=1
# ENABLE_HSTS=1

# --- Secrets (keep them out of the data directory in production) ------------
# At least 32 characters each. Generate with: openssl rand -base64 48
# If unset they are generated into data/*.key on first boot.
ENCRYPTION_KEY=
SESSION_SECRET=

# --- Features ----------------------------------------------------------------
# Shell and filesystem of the machine running this server (admins only).
ALLOW_LOCAL_SHELL=0

# --- Security policy -----------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
PASSWORD_MIN_LENGTH=12
LOCKOUT_THRESHOLD=8
LOCKOUT_MINUTES=15
TERMINAL_DETACH_MINUTES=60
MAX_TERMINALS_PER_USER=40
UPLOAD_LIMIT_MB=1024

LOG_LEVEL=info

{
  "name": "codefromhere",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "server": "node --watch server.js",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "basic-ftp": "^6.2.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "nanoid": "^5.1.16",
    "node-pty": "^1.1.0",
    "otpauth": "^9.6.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "description": "Cross-platform terminal + remote site manager + file transfer, ready for AI coding agents",
  "overrides": {
    "glob": "^14.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^8.8.3",
    "dockview-react": "^8.8.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "palmereta",
  "license": "MIT",
  "homepage": "https://github.com/palmereta/CodeFromHere",
  "repository": {
    "type": "git",
    "url": "https://github.com/palmereta/CodeFromHere.git"
  }
}
